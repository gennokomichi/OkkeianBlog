@model OkkeianBlog.Models.ViewModels.HomeIndexViewModel
@using System.Text.RegularExpressions
@using OkkeianBlog.Helpers

@{
    ViewData["Title"] = "Home Page";
}
<link rel="stylesheet" href="~/css/article.css" />
<link rel="stylesheet" href="~/css/sidebar.css" />
<link rel="stylesheet" href="~/css/rss-feed.css"/>


  @section RssSection {
    <div class="rss-section">
    <h2>新着RSS</h2>
    <div class="rss-box">
    @if (Model.RssItems != null && Model.RssItems.Any())
    {
        <ul>
            @foreach (var item in Model.RssItems)
            {
                <li>
                    <a href="@item.Link" target="_blank">@item.Title</a>
                </li>
            }
        </ul>
    }
    else
    {
        <p>RSSフィードは現在読み込まれていません。</p>
    }
</div>
</div>
}

<!-- RSSフィードの表示 -->



<h2>最新記事</h2>
<div class="article-list">
    @foreach (var article in Model.Articles)
    {
        if (article != null)
        {
            <div class="article-card">
                <!-- リンクで全体を囲む -->
                <a href="@Url.Action("ArticleDetails", "Home", new { id = article.Id })">
                    <!-- サムネイル画像の表示 -->
                    <div class="article-thumbnail">
                        @if (!string.IsNullOrWhiteSpace(article.ThumbnailPath))
                        {
                            <img src="@Url.Content(article.ThumbnailPath)" alt="サムネイル画像">
                        }
                        else
                        {
                            <img src="@Url.Content("~/uploads/default-thumbnail.jpg")" alt="デフォルトサムネイル">
                        }
                    </div>

                    <!-- 記事内容 -->
                    <div class="article-content">
                        <h3 class="article-title">
                            @article.Title
                        </h3>

                        <!-- 記事の抜粋 -->
                        <div class="article-excerpt">
                            @if (!string.IsNullOrEmpty(article.Content))
                            {
                                @article.Content.ToExcerpt(100)
                            }
                            else
                            {
                                <span>内容なし</span>
                            }
                        </div>
                        @if (article.PublishDate != DateTime.MinValue)
                        {
                            <span class="article-date">（@article.PublishDate.ToString("yyyy年MM月dd日")）</span>
                        }
                        else
                        {
                            <span class="article-date">投稿日なし</span>
                        }
                    </div>
                </a>
            </div>
        }
    }
</div>

   

