<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - okkeianBlog</title>
    
    <!-- Bootstrap の CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- 共通のサイト用 CSS -->
    <link rel="stylesheet" href="~/css/site.css"  asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css"  asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
   

    <!-- ページごとの CSS -->
    @if (ViewData["Title"]?.ToString() == "Home Page")
    {
        @:<link rel="stylesheet" href="~/css/homeindex.css" />
    }
    else if (ViewData["Title"]?.ToString() == "Article Details")
    {
        @:<link rel="stylesheet" href="~/css/article.css" />
    }

   

</head>

<body>
    <!-- 🏆 追加したヘッダー画像 -->
    <header class="site-header">
        <div class="header-image">
            <img src="~/uploads/okkeian_header.jpg" alt="サイトヘッダー画像">
        </div>
    </header>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">okkeianBlog</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Article" asp-action="Index">記事一覧</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

   <div class="container">
    <div class="row">
       

        <!-- 左サイドバー -->
        <aside class="col-md-3 sidebar">
          
            <h3>メニュー</h3>
            <ul>
                <li><a href="#">トップ</a></li>
                <li><a href="#">アーカイブ</a></li>
                <li><a href="#">他ブログリンク</a></li>
            </ul>
            
            <h5>人気記事</h5>
            <div class="popular-articles">
                @if (ViewData["PopularArticles"] is IEnumerable<OkkeianBlog.Models.ArticleSummaryViewModel> popularArticles)
                {
                  @foreach (var article in popularArticles)
                    {
                        <div class="article-card">
                            <a href="@Url.Action("ArticleDetails", "Home", new { id = article.Id })">
                                <!-- サムネイル画像の表示 -->
                               <img src="@Url.Content("/uploads/default-thumbnail.jpg")" alt="サムネイル画像" class="sidebar-thumbnail">


                                <h6>@article.Title</h6>
                                <p class="comment-count">@article.CommentCount コメント</p>
                            </a>
                        </div>
                    }


                }
                else
                {
                    <p>人気記事はありません。</p>
                }
            </div>
        </aside> <!-- サイドバーの閉じタグ -->
        
            <!-- メインコンテンツ -->
            <main class="col-md-9">
                @RenderBody() <!-- メインコンテンツをここに表示 -->
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - okkeianBlog - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
